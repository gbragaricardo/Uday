<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="UDayCore.Controls.UdayStepper"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="ThisStepper">

    <Border
        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundColor}, Dark={StaticResource CardBackgroundColorDark}}"
        HorizontalOptions="Start"
        Stroke="{AppThemeBinding Light={StaticResource LightTextColor}, Dark={StaticResource LightTextColorDark}}"
        StrokeShape="RoundRectangle 20"
        StrokeThickness="1">

        <Grid ColumnDefinitions="64, 64">

            <Button
                Grid.Column="0"
                BackgroundColor="Transparent"
                Clicked="OnMinusClicked"
                FontAttributes="Bold"
                FontSize="18"
                Text="-"
                TextColor="{StaticResource Primary}"
                VerticalOptions="Center" />

            <Button
                Grid.Column="1"
                BackgroundColor="{StaticResource Primary}"
                Clicked="OnPlusClicked"
                CornerRadius="0"
                FontAttributes="Bold"
                FontSize="18"
                Text="+"
                TextColor="{StaticResource White}" />

        </Grid>
    </Border>
</ContentView>