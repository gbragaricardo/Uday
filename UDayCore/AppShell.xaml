<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="UDayCore.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:UDayCore"
    xmlns:views="clr-namespace:UDayCore.Views"
    Title="UDayCore">

    <Shell.TitleView>
        <Label Text="MEUS DECKS" 
               TextColor="White" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" 
               VerticalOptions="Center" />
    </Shell.TitleView>

    <TabBar>
        <Tab Title="Routine">
            <ShellContent
                Title="Routine"
                ContentTemplate="{DataTemplate views:RoutinePage}"
                Route="RoutinePage" />

        </Tab>

        <Tab Title="Decks">
            <ShellContent
                Title="Decks"
                ContentTemplate="{DataTemplate views:DecksPage}"
                Route="DecksPage" />

        </Tab>
    </TabBar>

</Shell>
