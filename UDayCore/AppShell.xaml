<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="UDayCore.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:UDayCore"
    xmlns:views="clr-namespace:UDayCore.Views"
    Title="UDayCore">

    <Shell.TitleView>
        <Label Text="MEUS DECKS" 
               TextColor="White" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" 
               VerticalOptions="Center" />
    </Shell.TitleView>

    <TabBar>
        <Tab Title="Home">
            <ShellContent
                Title="Home"
                ContentTemplate="{DataTemplate views:HomePage}"
                Route="HomePage" />
        </Tab>

        <Tab Title="Tasks">
            <ShellContent
                Title="Tasks"
                ContentTemplate="{DataTemplate views:TasksPage}"
                Route="TasksPage" />
        </Tab>

        <Tab Title="DailyLog">
            <ShellContent
                Title="DailyLog"
                ContentTemplate="{DataTemplate views:DailyLogPage}"
                Route="DailyLogPage" />
        </Tab>
    </TabBar>

</Shell>
