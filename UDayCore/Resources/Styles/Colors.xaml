<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--  Note: For Android please see also Platforms\Android\Resources\values\colors.xml  -->

    <!-- Primary Palette -->
    <Color x:Key="Primary">#9C8EBD</Color>
    <Color x:Key="PrimaryDark">#8072A3</Color>
    <Color x:Key="PrimaryLight">#B3A7D1</Color>
    
    <Color x:Key="Secondary">#A3D4C0</Color>
    <Color x:Key="SecondaryDark">#89B9A6</Color>
    
    <Color x:Key="Tertiary">#F2A68D</Color>
    <Color x:Key="TertiaryDark">#D68D76</Color>

    <!-- Semantic Colors -->
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="Danger">#FF3B30</Color>
    <Color x:Key="DangerDark">#E03028</Color>
    <Color x:Key="Info">#3B82F6</Color>

    <!-- Grayscale / Neutral Palette -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="OffBlack">#1F1F1F</Color>
    
    <Color x:Key="Gray50">#F9FAFB</Color>
    <Color x:Key="Gray100">#F3F4F6</Color>
    <Color x:Key="Gray200">#E5E7EB</Color>
    <Color x:Key="Gray300">#D1D5DB</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#4B5563</Color>
    <Color x:Key="Gray700">#374151</Color>
    <Color x:Key="Gray800">#1F2937</Color>
    <Color x:Key="Gray900">#111827</Color>
    <Color x:Key="Gray950">#030712</Color>

    <!-- Application Themes Base -->
    <Color x:Key="AppBackgroundColor">#FAFAFA</Color>
    <Color x:Key="AppBackgroundColorDark">#121212</Color>
    
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="CardBackgroundColorDark">#1E1E1E</Color>
    
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="PrimaryDarkTextDark">#F5F5F5</Color>
    
    <Color x:Key="SecondaryDarkText">#242424</Color>
    <Color x:Key="SecondaryDarkTextDark">#F5F5F5</Color>
    
    <Color x:Key="TextColor">#8C8C8C</Color>
    <Color x:Key="TextColorDark">#A1A1A1</Color>
    
    <Color x:Key="LightTextColor">#B0B0B0</Color>
    <Color x:Key="LightTextColorDark">#6B7280</Color>

    <!-- Task Specific Colors -->
    <Color x:Key="PriorityLevel_High_Bg">#FEE2E2</Color>
    <Color x:Key="PriorityLevel_High_Bg_Dark">#450A0A</Color>
    <Color x:Key="PriorityLevel_High_Text">#EF4444</Color>
    <Color x:Key="PriorityLevel_High_Text_Dark">#F87171</Color>

    <Color x:Key="PriorityLevel_Medium_Bg">#FEF3C7</Color>
    <Color x:Key="PriorityLevel_Medium_Bg_Dark">#451A03</Color>
    <Color x:Key="PriorityLevel_Medium_Text">#F59E0B</Color>
    <Color x:Key="PriorityLevel_Medium_Text_Dark">#FBBF24</Color>
    
    <Color x:Key="PriorityLevel_Low_Bg">#DCFCE7</Color>
    <Color x:Key="PriorityLevel_Low_Bg_Dark">#064E3B</Color>
    <Color x:Key="PriorityLevel_Low_Text">#15803D</Color>
    <Color x:Key="PriorityLevel_Low_Text_Dark">#34D399</Color>

    <Color x:Key="EffortLevel_Heavy_Bg">#F3E8FF</Color>
    <Color x:Key="EffortLevel_Heavy_Bg_Dark">#3B0764</Color>
    <Color x:Key="EffortLevel_Heavy_Text">#9333EA</Color>
    <Color x:Key="EffortLevel_Heavy_Text_Dark">#C084FC</Color>

    <Color x:Key="EffortLevel_Medium_Bg">#E0F2FE</Color>
    <Color x:Key="EffortLevel_Medium_Bg_Dark">#082F49</Color>
    <Color x:Key="EffortLevel_Medium_Text">#3B82F6</Color>
    <Color x:Key="EffortLevel_Medium_Text_Dark">#60A5FA</Color>

    <Color x:Key="EffortLevel_Light_Bg">#F3F4F6</Color>
    <Color x:Key="EffortLevel_Light_Bg_Dark">#1F2937</Color>
    <Color x:Key="EffortLevel_Light_Text">#4B5563</Color>
    <Color x:Key="EffortLevel_Light_Text_Dark">#9CA3AF</Color>

    <!-- Legacy / Compatibility Colors -->
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    
    <!-- Theme Aware Brushes (used by some MAUI controls that don't support AppThemeBinding directly in some places) -->
    <!-- Note: In most cases, it's better to use AppThemeBinding on the property rather than the brush resource -->

</ResourceDictionary>