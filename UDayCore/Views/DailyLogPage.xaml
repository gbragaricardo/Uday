<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:UDayCore.ViewModels"
             x:Class="UDayCore.Views.DailyLogPage"
             Title="DailyLogPage">

    <ContentPage.BindingContext>
        <viewmodels:DailyLogViewModel />
    </ContentPage.BindingContext>

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">

            <Label Text="Como foi sua produtividade hoje?" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center"/>

            <Label Text="{Binding CurrentDateText}" 
                   FontSize="16" 
                   TextColor="Gray"
                   HorizontalOptions="Center" 
                   Margin="0,0,0,10"/>

            <CollectionView ItemsSource="{Binding LogEntries}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="#E0E0E0"
                                StrokeThickness="1"
                                Padding="15"
                                Margin="0,0,0,15">

                            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="10">

                                <Label Grid.Row="0" Grid.Column="0" 
                                       Text="{Binding Slot.DisplayName}" 
                                       FontAttributes="Bold" 
                                       VerticalOptions="Center"/>

                                <Label Grid.Row="0" Grid.Column="1" 
                                       Text="{Binding Score, StringFormat='{0}/10'}" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="#55AABB"
                                       VerticalOptions="Center"/>

                                <Slider Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                        Minimum="1" 
                                        Maximum="10" 
                                        Value="{Binding Score}" 
                                        MinimumTrackColor="#55AABB" 
                                        MaximumTrackColor="#E0E0E0"
                                        ThumbColor="#55AABB"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Salvar Registro" 
                    Command="{Binding SaveCommand}" 
                    BackgroundColor="#55AABB" 
                    TextColor="White" 
                    CornerRadius="10" 
                    HeightRequest="50" 
                    Margin="0,10,0,30" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>