<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:UDayCore.ViewModels"
             xmlns:enums="clr-namespace:UDayCore.Models.Enums"
             xmlns:controls="clr-namespace:UDayCore.Controls"
             x:Class="UDayCore.Views.CreateTaskPage"
             Title="CreateT askPage">

    <ContentPage.BindingContext>
        <viewmodels:CreateTaskViewModel/>
    </ContentPage.BindingContext>

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="8">

            <Label Text="Título *"
                   TextColor="{StaticResource TextColor}"
                   FontAttributes="Bold"/>
            
            <Border StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource CardBackgroundColor}"
                    Padding="4">

                <Entry Placeholder="Ex: Estudar Cálculo..." 
                       MaxLength="60"
                       PlaceholderColor="{StaticResource LightTextColor}"
                       TextColor="{StaticResource PrimaryDarkText}"
                       BackgroundColor="Transparent"/>
            </Border>


            <Label Text="Descrição"
                   TextColor="{StaticResource TextColor}"
                   FontSize="14"
                   FontAttributes="Bold"/>
            
            <Border StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource CardBackgroundColor}"
                    Padding="4">

                <Editor Placeholder="Ex: Descrição" 
                        MaxLength="450"
                        PlaceholderColor="{StaticResource LightTextColor}"
                        TextColor="{StaticResource PrimaryDarkText}"
                        BackgroundColor="{StaticResource CardBackgroundColor}"
                        AutoSize="TextChanges"/>

            </Border>

            <VerticalStackLayout Spacing="5">
                <Label Text="Duração (em minutos)"
                       TextColor="{StaticResource TextColor}"
                       FontAttributes="Bold"/>

                <HorizontalStackLayout BackgroundColor="{StaticResource CardBackgroundColor}"
                                       Spacing="8">

                    <Label Text="{Binding Duration, StringFormat='{0} minutos'}"
                           VerticalOptions="Center" TextColor="{StaticResource PrimaryDarkText}"
                           FontSize="16"/>

                    <controls:UdayStepper Grid.Column="1" 
                                          Minimum="0" 
                                          Maximum="480" 
                                          Increment="15" 
                                          Value="{Binding Duration}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Label Text="Data inicio"
                   TextColor="{StaticResource TextColor}"
                   FontSize="14"
                   FontAttributes="Bold"/>

            <Border StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource CardBackgroundColor}"
                    Padding="4">

                <DatePicker TextColor="{StaticResource PrimaryDarkText}"
                            BackgroundColor="{StaticResource CardBackgroundColor}"/>
            </Border>

            <Label Text="DeadLine"
                   TextColor="{StaticResource TextColor}"
                   FontSize="14"
                   FontAttributes="Bold"/>

            <Border StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource CardBackgroundColor}"
                    Padding="4">

                <DatePicker TextColor="{StaticResource PrimaryDarkText}"
                            BackgroundColor="{StaticResource CardBackgroundColor}"/>
            </Border>

            <VerticalStackLayout Spacing="5" Margin="0,0,0,8"
                                 RadioButtonGroup.GroupName="EffortGroup"
                                 RadioButtonGroup.SelectedValue="{Binding SelectedEffortLevel, Mode=TwoWay}">

                <Label Text="Nível de Esforço" 
                       TextColor="{StaticResource TextColor}" 
                       FontAttributes="Bold"/>

                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10" Margin="0,5">
                    <RadioButton Grid.Column="0" 
                                 Content="Leve" 
                                 Value="{x:Static enums:EffortLevel.Light}"
                                 Style="{StaticResource ModernChipStyle}" />

                    <RadioButton Grid.Column="1" 
                                 Content="Médio" 
                                 Value="{x:Static enums:EffortLevel.Medium}"
                                 Style="{StaticResource ModernChipStyle}" />

                    <RadioButton Grid.Column="2" 
                                 Content="Pesado" 
                                 Value="{x:Static enums:EffortLevel.Heavy}"
                                 Style="{StaticResource ModernChipStyle}" />
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8"
                     RadioButtonGroup.GroupName="PriorityGroup"
                     RadioButtonGroup.SelectedValue="{Binding SelectedPriority, Mode=TwoWay}">

                <Label Text="Prioridade" 
                       TextColor="{StaticResource TextColor}" 
                       FontAttributes="Bold"/>

                <Grid ColumnDefinitions="*, *, *"
                      ColumnSpacing="8">

                    <RadioButton Content="Baixa" 
                                 Value="{x:Static enums:PriorityLevel.Low}"
                                 Style="{StaticResource ModernChipStyle}"/>

                    <RadioButton Grid.Column="1" 
                                 Content="Média" 
                                 Value="{x:Static enums:PriorityLevel.Medium}"
                                 Style="{StaticResource ModernChipStyle}"/>

                    <RadioButton Grid.Column="2" 
                                 Content="Alta" 
                                 Value="{x:Static enums:PriorityLevel.High}"
                                 Style="{StaticResource ModernChipStyle}"/>
                </Grid>
            </VerticalStackLayout>

            <Switch/>

            <Label Text="Periodo de recorrencia"
                   TextColor="{StaticResource TextColor}"
                   FontSize="14"
                   FontAttributes="Bold"/>

            <Picker TextColor="{StaticResource PrimaryDarkText}"
                    BackgroundColor="{StaticResource CardBackgroundColor}"
                    ItemsSource="{Binding Priorities}"
                    SelectedItem="{Binding SelectedPriority}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>