<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UDayCore.Views.CreateTaskPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:UDayCore.Controls"
    xmlns:converters="clr-namespace:UDayCore.Converters"
    xmlns:enums="clr-namespace:UDayCore.Models.Enums"
    xmlns:viewModels="clr-namespace:UDayCore.ViewModels"
    Title="Create TaskPage"
    x:DataType="viewModels:CreateTaskViewModel">

    <ContentPage.Resources>
        <converters:EnumTranslationConverter x:Key="EnumTranslator" />
    </ContentPage.Resources>

    <ScrollView Padding="16">
        <Grid RowDefinitions="*, Auto">
            <VerticalStackLayout
                Grid.Row="0"
                Padding="0,16"
                Spacing="16">

                <VerticalStackLayout Spacing="4">

                    <Label
                        FontAttributes="Bold"
                        Text="Título"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />

                    <Border
                        Padding="4"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundColor}, Dark={StaticResource CardBackgroundColorDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="1">

                        <Entry
                            BackgroundColor="Transparent"
                            MaxLength="60"
                            Placeholder="Título"
                            PlaceholderColor="{AppThemeBinding Light={StaticResource LightTextColor}, Dark={StaticResource LightTextColorDark}}"
                            Text="{Binding Title, Mode=TwoWay}"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource PrimaryDarkTextDark}}" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">

                    <Label
                        FontAttributes="Bold"
                        Text="Descrição"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />

                    <Border
                        Padding="4"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundColor}, Dark={StaticResource CardBackgroundColorDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="1">

                        <Editor
                            AutoSize="TextChanges"
                            BackgroundColor="Transparent"
                            MaxLength="450"
                            Placeholder="Descrição (opcional)"
                            PlaceholderColor="{AppThemeBinding Light={StaticResource LightTextColor}, Dark={StaticResource LightTextColorDark}}"
                            Text="{Binding Description, Mode=TwoWay}"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource PrimaryDarkTextDark}}" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">

                    <Label
                        FontAttributes="Bold"
                        Text="Duração estimada:"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />

                    <HorizontalStackLayout Spacing="16">

                        <Border
                            Padding="24,0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundColor}, Dark={StaticResource CardBackgroundColorDark}}"
                            MinimumWidthRequest="156"
                            Stroke="{AppThemeBinding Light={StaticResource LightTextColor}, Dark={StaticResource LightTextColorDark}}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1">

                            <Label
                                FontSize="14"
                                HorizontalOptions="Center"
                                Text="{Binding EstimatedDurationMinutes, StringFormat='{0} minutos'}"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource PrimaryDarkTextDark}}"
                                VerticalOptions="Center" />
                        </Border>

                        <controls:UdayStepper
                            Grid.Column="1"
                            Increment="15"
                            Maximum="240"
                            Minimum="15"
                            Value="{Binding EstimatedDurationMinutes}" />

                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">

                    <Label
                        FontAttributes="Bold"
                        Text="Tipo de prazo"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />

                    <Border
                        Padding="4,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundColor}, Dark={StaticResource CardBackgroundColorDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="1">

                        <Picker
                            Title="Quando?"
                            ItemDisplayBinding="{Binding ., Converter={StaticResource EnumTranslator}}"
                            ItemsSource="{Binding ScheduleOptions}"
                            SelectedItem="{Binding SelectedScheduleType}"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource PrimaryDarkTextDark}}" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout
                    IsVisible="{Binding IsRecurrenceVisisble, Mode=TwoWay}"
                    RadioButtonGroup.GroupName="RecurrenceTypeGroup"
                    RadioButtonGroup.SelectedValue="{Binding SelectedRecurrenceType, Mode=TwoWay}"
                    Spacing="5">

                    <Label
                        FontAttributes="Bold"
                        Text="Periodo de recorrencia"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />

                    <Grid
                        Margin="0,5"
                        ColumnDefinitions="*, *, *, *"
                        ColumnSpacing="10">
                        <RadioButton
                            Grid.Column="0"
                            Content="Diário"
                            Style="{StaticResource ModernChipStyle}"
                            Value="{Binding Source={x:Static enums:RecurrenceType.Daily}, Converter={StaticResource EnumTranslator}}" />

                        <RadioButton
                            Grid.Column="1"
                            Content="Semanal"
                            Style="{StaticResource ModernChipStyle}"
                            Value="{Binding Source={x:Static enums:RecurrenceType.Weekly}, Converter={StaticResource EnumTranslator}}" />

                        <RadioButton
                            Grid.Column="2"
                            Content="Mensal"
                            Style="{StaticResource ModernChipStyle}"
                            Value="{Binding Source={x:Static enums:RecurrenceType.Monthly}, Converter={StaticResource EnumTranslator}}" />

                        <RadioButton
                            Grid.Column="3"
                            Content="Anual"
                            Style="{StaticResource ModernChipStyle}"
                            Value="{Binding Source={x:Static enums:RecurrenceType.Yearly}, Converter={StaticResource EnumTranslator}}" />
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsSingleDateVisible}" Spacing="5">

                    <Label
                        Margin="5,0,0,0"
                        FontAttributes="Bold"
                        Text="Data da Tarefa"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />

                    <Border
                        Padding="8,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundColor}, Dark={StaticResource CardBackgroundColorDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource LightTextColor}, Dark={StaticResource LightTextColorDark}}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="1">

                        <DatePicker Date="{Binding DueDate}" TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource PrimaryDarkTextDark}}" />
                    </Border>
                </VerticalStackLayout>


                <Grid
                    ColumnDefinitions="*, *"
                    ColumnSpacing="15"
                    IsVisible="{Binding IsTimeframeVisible}">

                    <VerticalStackLayout Grid.Column="0" Spacing="5">

                        <Label
                            Margin="5,0,0,0"
                            FontAttributes="Bold"
                            Text="Início"
                            TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />

                        <Border
                            Padding="10,0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundColor}, Dark={StaticResource CardBackgroundColorDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource LightTextColor}, Dark={StaticResource LightTextColorDark}}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1">

                            <DatePicker Date="{Binding AvailableFrom}" TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource PrimaryDarkTextDark}}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="5">

                        <Label
                            Margin="5,0,0,0"
                            FontAttributes="Bold"
                            Text="Prazo Final"
                            TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />

                        <Border
                            Padding="10,0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundColor}, Dark={StaticResource CardBackgroundColorDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource LightTextColor}, Dark={StaticResource LightTextColorDark}}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1">

                            <DatePicker Date="{Binding DueDate}" TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource PrimaryDarkTextDark}}" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout IsVisible="{Binding IsTimeBoxVisible}" Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        Text="Período"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />

                    <Border
                        Padding="4,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundColor}, Dark={StaticResource CardBackgroundColorDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource LightTextColor}, Dark={StaticResource LightTextColorDark}}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="1">

                        <Picker
                            Title="Selecione o período"
                            ItemDisplayBinding="{Binding ., Converter={StaticResource EnumTranslator}}"
                            ItemsSource="{Binding TimeBoxOptions}"
                            SelectedItem="{Binding SelectedTimeBox}"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource PrimaryDarkTextDark}}" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout
                    RadioButtonGroup.GroupName="EffortGroup"
                    RadioButtonGroup.SelectedValue="{Binding SelectedEffortLevel, Mode=TwoWay}"
                    Spacing="4">

                    <Label
                        FontAttributes="Bold"
                        Text="Nível de Esforço"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />

                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                        <RadioButton
                            Grid.Column="0"
                            Content="Leve"
                            Style="{StaticResource ModernChipStyle}"
                            Value="{Binding Source={x:Static enums:EffortLevel.Light}, Converter={StaticResource EnumTranslator}}" />

                        <RadioButton
                            Grid.Column="1"
                            Content="Médio"
                            Style="{StaticResource ModernChipStyle}"
                            Value="{Binding Source={x:Static enums:EffortLevel.Medium}, Converter={StaticResource EnumTranslator}}" />

                        <RadioButton
                            Grid.Column="2"
                            Content="Pesado"
                            Style="{StaticResource ModernChipStyle}"
                            Value="{Binding Source={x:Static enums:EffortLevel.Heavy}, Converter={StaticResource EnumTranslator}}" />
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout
                    RadioButtonGroup.GroupName="PriorityGroup"
                    RadioButtonGroup.SelectedValue="{Binding SelectedPriority, Mode=TwoWay}"
                    Spacing="4">

                    <Label
                        FontAttributes="Bold"
                        Text="Prioridade"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />

                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">

                        <RadioButton
                            Content="Baixa"
                            Style="{StaticResource ModernChipStyle}"
                            Value="{Binding Source={x:Static enums:PriorityLevel.Low}, Converter={StaticResource EnumTranslator}}" />

                        <RadioButton
                            Grid.Column="1"
                            Content="Média"
                            Style="{StaticResource ModernChipStyle}"
                            Value="{Binding Source={x:Static enums:PriorityLevel.Medium}, Converter={StaticResource EnumTranslator}}" />

                        <RadioButton
                            Grid.Column="2"
                            Content="Alta"
                            Style="{StaticResource ModernChipStyle}"
                            Value="{Binding Source={x:Static enums:PriorityLevel.High}, Converter={StaticResource EnumTranslator}}" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Button
                Grid.Row="1"
                Command="{Binding CreateTaskItemCommand}"
                Text="Criar Tarefa" />
        </Grid>
    </ScrollView>
</ContentPage>